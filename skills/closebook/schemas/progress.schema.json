{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:closebook:progress:1.0",
  "title": "closebook progress file",
  "description": "Learning progress for one topic. Fields tagged x-tier=core are needed to resume learning and are kept in the compact export; x-tier=extension fields are optional analytics and decision records. Core fields that are empty or default (false, [], null) may be omitted.",
  "type": "object",
  "required": ["schema_version", "topic", "updated", "knowledge_points", "weak_points"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "x-tier": "core", "type": "string", "pattern": "^1\\.[0-9]+$", "description": "Major version 1. Tools refuse other majors." },
    "profile": { "x-tier": "core", "type": "string", "enum": ["core", "full"], "description": "core = compact export with core fields only; full = everything." },
    "topic": { "x-tier": "core", "type": "string", "minLength": 1 },
    "language": { "x-tier": "core", "type": "string", "description": "Learner's language, BCP 47 tag such as zh-CN or en." },
    "created": { "x-tier": "core", "$ref": "#/$defs/date" },
    "updated": { "x-tier": "core", "$ref": "#/$defs/date" },
    "settings": { "x-tier": "core", "$ref": "#/$defs/settings" },
    "exam": { "x-tier": "core", "$ref": "#/$defs/exam" },
    "knowledge_points": {
      "x-tier": "core",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/knowledge_point" }
    },
    "weak_points": {
      "x-tier": "core",
      "type": "array",
      "items": { "$ref": "#/$defs/weak_point" }
    },
    "sessions": {
      "x-tier": "extension",
      "type": "array",
      "items": { "$ref": "#/$defs/session" }
    },
    "user_overrides": {
      "x-tier": "extension",
      "type": "array",
      "items": { "$ref": "#/$defs/override_event" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "datetime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})?)?$",
      "description": "Date or ISO 8601 date-time. Scheduling uses the date part."
    },
    "importance": { "type": "string", "enum": ["core", "important", "minor"] },
    "knowledge_type": {
      "type": "string",
      "enum": ["factual", "conceptual", "procedural", "judgment", "language_production", "contested"]
    },
    "method": {
      "type": "string",
      "enum": [
        "retrieval", "spaced_repetition", "error_review", "feynman", "interleaving",
        "elaborative_interrogation", "self_explanation", "predict_verify", "calibration",
        "chunking_mnemonics", "difficulty_tuning", "mini_project"
      ]
    },
    "interaction": {
      "type": "string",
      "enum": [
        "plain_qa", "mcq", "flashcard", "free_text", "diagram_fill", "simulation",
        "timeline_fill", "compare_table_fill", "checklist", "voice"
      ]
    },
    "error_type": {
      "type": "string",
      "enum": ["misconception", "memory_lapse", "careless", "misread", "transfer_failure"]
    },
    "result": {
      "type": "string",
      "enum": ["correct", "partial", "incorrect", "dont_know", "coherent", "partly_coherent", "incoherent"],
      "description": "coherent / partly_coherent / incoherent are for contested points, judged on reasoning, not correctness."
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leitner_intervals_days": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "integer", "minimum": 1, "maximum": 3650 },
          "description": "Days until next review for boxes 1-5. Default [1, 3, 7, 14, 30]."
        },
        "review_batch_size": { "type": "integer", "minimum": 1, "maximum": 50, "description": "Default 8." },
        "interleaving": { "type": "string", "enum": ["auto", "on", "off"], "description": "Default auto." }
      }
    },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "format": { "type": "string" },
        "syllabus_points_total": { "type": "integer", "minimum": 1 }
      }
    },
    "weak_point": {
      "type": "object",
      "required": ["kp_id"],
      "additionalProperties": false,
      "properties": {
        "kp_id": { "type": "string" },
        "note": { "type": "string", "description": "The specific gap, e.g. 'confuses no-cache with no-store'." }
      }
    },
    "knowledge_point": {
      "type": "object",
      "required": ["id", "title", "importance", "knowledge_type", "mastery", "leitner_box", "next_review", "attempts"],
      "additionalProperties": false,
      "properties": {
        "id": { "x-tier": "core", "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
        "title": { "x-tier": "core", "type": "string", "minLength": 1 },
        "importance": { "x-tier": "core", "$ref": "#/$defs/importance" },
        "knowledge_type": { "x-tier": "core", "$ref": "#/$defs/knowledge_type" },
        "secondary_types": {
          "x-tier": "core",
          "type": "array",
          "items": { "$ref": "#/$defs/knowledge_type" }
        },
        "status": {
          "x-tier": "core",
          "type": "string",
          "enum": ["active", "skipped_known", "optional_extension"],
          "description": "Default active. optional_extension = trimmed by 80/20, not scheduled."
        },
        "mastery": { "x-tier": "core", "type": "string", "enum": ["not_assessed", "weak", "fuzzy", "solid"] },
        "leitner_box": { "x-tier": "core", "type": "integer", "minimum": 0, "maximum": 5, "description": "0 = not scheduled yet." },
        "next_review": { "x-tier": "core", "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "last_reviewed": { "x-tier": "core", "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "priority_flag": { "x-tier": "core", "type": "boolean", "description": "Set by a high-confidence error; reviewed first." },
        "attempts": {
          "x-tier": "core",
          "type": "array",
          "items": { "$ref": "#/$defs/attempt" }
        },
        "errors": {
          "x-tier": "core",
          "type": "array",
          "items": { "$ref": "#/$defs/error_entry" }
        },
        "feynman": {
          "x-tier": "core",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/feynman" }]
        },
        "plain_talk_used": { "x-tier": "core", "type": "boolean" },
        "plain_talk_recall_result": {
          "x-tier": "core",
          "type": ["string", "null"],
          "enum": ["correct", "partial", "incorrect", null]
        },
        "mnemonics": {
          "x-tier": "extension",
          "type": "array",
          "items": { "type": "string" },
          "description": "Memory hooks the learner built, in their own words."
        },
        "methods_selected": {
          "x-tier": "extension",
          "type": "array",
          "items": { "$ref": "#/$defs/method" }
        },
        "methods_skipped": {
          "x-tier": "extension",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["method", "reason"],
            "additionalProperties": false,
            "properties": {
              "method": { "$ref": "#/$defs/method" },
              "reason": { "type": "string" }
            }
          }
        },
        "methods_insensitive": {
          "x-tier": "extension",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["method"],
            "additionalProperties": false,
            "properties": {
              "method": { "$ref": "#/$defs/method" },
              "note": { "type": "string" }
            }
          }
        },
        "method_override_by_user": {
          "x-tier": "extension",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/override" }]
        },
        "method_fit_flag": { "x-tier": "extension", "type": "string", "enum": ["ok", "needs_review"] },
        "interaction_selected": { "x-tier": "extension", "$ref": "#/$defs/interaction" },
        "interaction_downgraded_from": {
          "x-tier": "extension",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["from", "reason"],
              "additionalProperties": false,
              "properties": {
                "from": { "$ref": "#/$defs/interaction" },
                "reason": { "type": "string" }
              }
            }
          ]
        },
        "interaction_override_by_user": {
          "x-tier": "extension",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/override" }]
        },
        "efficiency": {
          "x-tier": "extension",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minutes_spent": { "type": "number", "minimum": 0 },
            "minutes_is_estimate": { "type": "boolean" },
            "rounds_to_mastery": { "type": ["integer", "null"], "minimum": 0 },
            "first_retest_correct": { "type": ["boolean", "null"] }
          }
        },
        "notes": { "x-tier": "extension", "type": "string" }
      }
    },
    "attempt": {
      "type": "object",
      "required": ["at", "phase", "result"],
      "additionalProperties": false,
      "properties": {
        "id": { "x-tier": "core", "type": "string", "description": "Unique within the knowledge point; used to deduplicate merges." },
        "at": { "x-tier": "core", "$ref": "#/$defs/datetime" },
        "phase": {
          "x-tier": "core",
          "type": "string",
          "enum": ["diagnostic", "verify_known", "retest", "review", "synthesis", "plain_talk_recall", "project"],
          "description": "diagnostic never affects scheduling."
        },
        "result": { "x-tier": "core", "$ref": "#/$defs/result" },
        "hint_level": { "x-tier": "core", "type": "integer", "minimum": 0, "maximum": 3, "description": "0 none, 1 keyword, 2 structure, 3 answer shown. Default 0." },
        "confidence": { "x-tier": "core", "type": ["integer", "null"], "minimum": 1, "maximum": 3, "description": "Only for questions with a right answer." },
        "error_type": {
          "x-tier": "core",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error_type" }]
        },
        "question": { "x-tier": "extension", "type": "string" },
        "question_format": {
          "x-tier": "extension",
          "type": "string",
          "enum": ["free_recall", "cloze", "short_answer", "mcq", "flashcard", "explain", "explain_steps", "why", "predict", "produce", "apply", "compare", "project", "other"]
        },
        "method": { "x-tier": "extension", "$ref": "#/$defs/method" },
        "interaction": { "x-tier": "extension", "$ref": "#/$defs/interaction" },
        "duration_sec": { "x-tier": "extension", "type": "integer", "minimum": 0, "description": "Only when measured; never estimated." },
        "self_assessed": { "x-tier": "extension", "type": "boolean", "description": "Learner graded it (e.g. free text in a static HTML page)." },
        "coach_graded": { "x-tier": "extension", "type": "boolean", "description": "The coach graded it after the learner pasted the answer back (see grading.schema.json); `note` holds the feedback." },
        "source": { "x-tier": "extension", "type": "string", "enum": ["chat", "file", "html"] },
        "note": { "x-tier": "extension", "type": "string" }
      }
    },
    "error_entry": {
      "type": "object",
      "required": ["at", "error_type"],
      "additionalProperties": false,
      "properties": {
        "at": { "$ref": "#/$defs/datetime" },
        "question": { "type": "string" },
        "error_type": { "$ref": "#/$defs/error_type" },
        "high_confidence": { "type": "boolean" },
        "remedy": { "type": "string" },
        "resolved": { "type": "boolean", "description": "True once a later-day, hint-free, first-of-day answer was correct." }
      }
    },
    "feynman": {
      "type": "object",
      "required": ["at", "accuracy", "completeness", "plainness"],
      "additionalProperties": false,
      "properties": {
        "at": { "$ref": "#/$defs/datetime" },
        "accuracy": { "type": "integer", "minimum": 0, "maximum": 2 },
        "completeness": { "type": "integer", "minimum": 0, "maximum": 2 },
        "plainness": { "type": "integer", "minimum": 0, "maximum": 2 },
        "jargon_masking": { "type": "boolean" },
        "gaps": { "type": "array", "items": { "type": "string" } },
        "rounds": { "type": "integer", "minimum": 1 }
      }
    },
    "override": {
      "type": "object",
      "required": ["requested"],
      "additionalProperties": false,
      "properties": {
        "requested": { "type": "string" },
        "recommended": { "type": "string" },
        "risk_note": { "type": "string" },
        "at": { "$ref": "#/$defs/datetime" }
      }
    },
    "override_event": {
      "type": "object",
      "required": ["at", "scope", "requested"],
      "additionalProperties": false,
      "properties": {
        "at": { "$ref": "#/$defs/datetime" },
        "scope": { "type": "string", "enum": ["method", "interaction", "flow"] },
        "kp_id": { "type": "string" },
        "requested": { "type": "string" },
        "recommended": { "type": "string" },
        "risk_note": { "type": "string" }
      }
    },
    "session": {
      "type": "object",
      "required": ["date"],
      "additionalProperties": false,
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "mode": { "type": "string", "enum": ["general", "exam", "coding", "language", "concept", "review"] },
        "entry_path": { "type": "string", "enum": ["A", "B"] },
        "minutes_planned": { "type": "integer", "minimum": 0 },
        "minutes_actual": { "type": "integer", "minimum": 0 },
        "platform_level": { "type": "integer", "minimum": 0, "maximum": 2 },
        "kp_ids": { "type": "array", "items": { "type": "string" } },
        "plain_talk_mode": { "type": "string", "enum": ["after", "preview", "midway"] },
        "notes": { "type": "string" }
      }
    }
  }
}
