{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:closebook:lesson-data:1.0",
  "title": "closebook lesson data",
  "description": "Content for assets/lesson-template.html. The model writes only this JSON; the page's logic never changes. Build with scripts/build_lesson.py, which also checks the per-type rules that JSON Schema can't express here.",
  "type": "object",
  "required": ["schema_version", "lesson_id", "topic", "language", "knowledge_points"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "lesson_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$", "description": "Stable id; used in attempt ids and browser storage." },
    "topic": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "description": "BCP 47 tag. zh* shows a Chinese interface, anything else English." },
    "created": { "$ref": "progress.schema.json#/$defs/date" },
    "mode": { "type": "string", "enum": ["learn", "review"], "description": "learn = explanation blocks before questions (path B); review = questions first, explanation only afterwards." },
    "intro": { "type": "string" },
    "knowledge_points": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/knowledge_point" }
    },
    "free_recall": { "$ref": "#/$defs/free_recall" },
    "plain_talk": { "$ref": "#/$defs/plain_talk" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
    "knowledge_point": {
      "type": "object",
      "required": ["id", "title", "importance", "knowledge_type", "interaction_type", "interaction_reason", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "importance": { "$ref": "progress.schema.json#/$defs/importance" },
        "knowledge_type": { "$ref": "progress.schema.json#/$defs/knowledge_type" },
        "secondary_types": { "type": "array", "items": { "$ref": "progress.schema.json#/$defs/knowledge_type" } },
        "method": { "$ref": "progress.schema.json#/$defs/method" },
        "interaction_type": {
          "type": "string",
          "enum": ["mcq", "flashcard", "free_text", "diagram_fill", "simulation", "timeline_fill", "compare_table_fill", "plain_qa",
                   "numeric", "order_steps", "cloze_passage", "code_trace", "terminal", "graph"],
          "description": "Unknown values are shown as plain_qa by the page."
        },
        "interaction_reason": { "type": "string", "minLength": 1, "description": "One sentence: what this form saves or improves compared with plain Q&A." },
        "teach": { "$ref": "#/$defs/teach" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
      }
    },
    "teach": {
      "type": "object",
      "additionalProperties": false,
      "description": "Minimal teaching block (about 150 words): one example + one sentence of principle, optionally split into steps shown one at a time.",
      "properties": {
        "steps": { "type": "array", "items": { "type": "string" } },
        "example": { "type": "string" },
        "principle": { "type": "string" }
      }
    },
    "cell": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "description": "Shown as-is, or the expected answer when blank is true." },
        "blank": { "type": "boolean" },
        "accept": { "type": "array", "items": { "type": "string" }, "description": "Accepted answers for automatic matching; defaults to [text]." }
      }
    },
    "option": {
      "type": "object",
      "required": ["text", "correct", "explanation"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "correct": { "type": "boolean" },
        "explanation": { "type": "string", "description": "Why it's right, or which misconception it represents." }
      }
    },
    "param": {
      "type": "object",
      "required": ["name", "min", "max", "value"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,15}$", "description": "Used in expressions; not x, pi or e." },
        "label": { "type": "string", "description": "Shown next to the slider; defaults to name." },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "minimum": 0, "description": "Default: (max - min) / 100." },
        "value": { "type": "number", "description": "Starting value." },
        "unit": { "type": "string" }
      }
    },
    "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "item": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "description": "Fields used depend on the point's interaction_type; build_lesson.py checks them.",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "question": { "type": "string" },
        "prompt": { "type": "string" },
        "code": { "type": "string", "description": "Optional code shown in a block under the question." },
        "hint": { "type": "string", "description": "Level-1 hint. Using it records hint_level 1." },
        "question_format": {
          "type": "string",
          "enum": ["free_recall", "cloze", "short_answer", "mcq", "flashcard", "explain", "explain_steps", "why", "predict", "produce", "apply", "compare", "project", "other"]
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/option" }
        },
        "front": { "type": "string" },
        "back": { "type": "string" },
        "answer": { "type": "string" },
        "accept": { "type": "array", "items": { "type": "string" } },
        "case_sensitive": { "type": "boolean" },
        "explanation": { "type": "string" },
        "format_hint": { "type": "string" },
        "reference_points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string" },
              "required": { "type": "boolean" }
            }
          }
        },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "cells"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "cells": { "type": "array", "items": { "$ref": "#/$defs/cell" } }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["when", "what"],
            "additionalProperties": false,
            "properties": {
              "when": { "type": "string" },
              "what": { "type": "string" },
              "blank": { "type": "string", "enum": ["when", "what"] },
              "accept": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string" },
              "blank": { "type": "boolean" },
              "accept": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "value": { "type": "number", "description": "numeric: the correct value." },
        "tolerance": { "type": "number", "minimum": 0, "description": "numeric: accepted absolute difference; graph: accepted difference per parameter." },
        "tolerance_pct": { "type": "number", "minimum": 0, "description": "numeric: accepted relative difference in percent (used if larger than tolerance)." },
        "unit": { "type": "string", "description": "numeric: shown after the input and the answer." },
        "solution": { "type": "array", "items": { "type": "string" }, "description": "numeric: worked steps shown after answering." },
        "steps": { "type": "array", "items": { "type": "string" }, "description": "order_steps: the items in the correct order." },
        "distractors": { "type": "array", "items": { "type": "string" }, "description": "order_steps: items that don't belong (Parsons problems)." },
        "alternatives": { "type": "array", "items": { "type": "array", "items": { "type": "string" } }, "description": "order_steps: other complete orders that are also right." },
        "layout": { "type": "string", "enum": ["list", "tiles"], "description": "order_steps: list (rows with arrows) or tiles (word tiles in a line, for sentence building)." },
        "monospace": { "type": "boolean", "description": "order_steps: show items as code lines." },
        "text": { "type": "string", "description": "cloze_passage: passage with blanks written [[answer|variant|variant]]." },
        "bank": { "type": "boolean", "description": "cloze_passage: show the answers as a word bank." },
        "bank_extra": { "type": "array", "items": { "type": "string" }, "description": "cloze_passage: extra wrong words for the bank." },
        "language": { "type": "string", "description": "code_trace: language label, e.g. Python." },
        "trace": {
          "type": "array",
          "description": "code_trace: execution steps, shown only after the learner's predictions are checked.",
          "items": {
            "type": "object",
            "required": ["line"],
            "additionalProperties": false,
            "properties": {
              "line": { "type": "integer", "minimum": 1 },
              "vars": { "type": "object", "description": "Variable name -> value (string or number) after this line." },
              "out": { "type": "string", "description": "Text printed by this line." },
              "note": { "type": "string" }
            }
          }
        },
        "questions": {
          "type": "array",
          "description": "code_trace: prediction questions answered before the trace is shown.",
          "items": {
            "type": "object",
            "required": ["question", "answer"],
            "additionalProperties": false,
            "properties": {
              "question": { "type": "string" },
              "answer": { "type": "string" },
              "comparison": { "type": "string", "enum": ["exact", "container"], "description": "Defaults to exact. Use container only for a list/tuple/dict/set representation whose punctuation spacing is irrelevant, never for literal printed text." },
              "accept": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "setup": { "type": "string", "description": "terminal: earlier session text shown above the first prompt." },
        "shell_prompt": { "type": "string", "description": "terminal: prompt symbol; default $." },
        "commands": {
          "type": "array",
          "description": "terminal: one task per step; the learner types the command.",
          "items": {
            "type": "object",
            "required": ["task", "accept"],
            "additionalProperties": false,
            "properties": {
              "task": { "type": "string" },
              "accept": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Accepted commands (whitespace-normalised, case-sensitive)." },
              "output": { "type": "string", "description": "Scripted output shown when the command is accepted." },
              "hint": { "type": "string" }
            }
          }
        },
        "expr": { "type": "string", "description": "graph: y as a function of x and the params, e.g. a*(x-h)^2+k." },
        "params": { "type": "array", "items": { "$ref": "#/$defs/param" }, "description": "graph, simulation: sliders." },
        "x_range": { "$ref": "#/$defs/range" },
        "y_range": { "$ref": "#/$defs/range" },
        "x_label": { "type": "string" },
        "y_label": { "type": "string" },
        "target": { "type": "object", "description": "graph: param name -> target value; the learner matches the dashed target curve." },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "label": { "type": "string" } }
          }
        },
        "predict": {
          "type": "object",
          "required": ["question", "options"],
          "additionalProperties": false,
          "description": "graph, simulation: a prediction asked before the sliders unlock.",
          "properties": {
            "question": { "type": "string" },
            "options": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/option" } }
          }
        },
        "outputs": {
          "type": "array",
          "description": "simulation: computed readouts.",
          "items": {
            "type": "object",
            "required": ["label", "expr"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "expr": { "type": "string" },
              "unit": { "type": "string" },
              "digits": { "type": "integer", "minimum": 0, "maximum": 10 }
            }
          }
        },
        "plot": {
          "type": "object",
          "required": ["expr", "x_range", "y_range"],
          "additionalProperties": false,
          "description": "simulation: optional curve of expr over x.",
          "properties": {
            "expr": { "type": "string" },
            "x_range": { "$ref": "#/$defs/range" },
            "y_range": { "$ref": "#/$defs/range" },
            "x_label": { "type": "string" },
            "y_label": { "type": "string" }
          }
        },
        "fallback": {
          "type": "object",
          "required": ["question", "answer"],
          "additionalProperties": false,
          "description": "Plain question for pages or chats that can't render this item; for a simulation without params it's what the page shows.",
          "properties": {
            "question": { "type": "string" },
            "code": { "type": "string" },
            "answer": { "type": "string" },
            "accept": { "type": "array", "items": { "type": "string" } },
            "explanation": { "type": "string" }
          }
        }
      }
    },
    "free_recall": {
      "type": "object",
      "required": ["prompt", "reference_points"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string" },
        "reference_points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["text", "kp_id"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string" },
              "kp_id": { "type": "string" },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    },
    "plain_talk": {
      "type": "object",
      "required": ["points", "summary", "recall"],
      "additionalProperties": false,
      "properties": {
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kp_id", "conclusion", "example", "pitfall"],
            "additionalProperties": false,
            "properties": {
              "kp_id": { "type": "string" },
              "conclusion": { "type": "string" },
              "analogy": { "type": "string" },
              "analogy_limit": { "type": "string" },
              "no_analogy_reason": { "type": "string", "description": "For precise definitions, formulas, legal text: why there's no analogy." },
              "example": { "type": "string" },
              "pitfall": { "type": "string" }
            }
          }
        },
        "summary": { "type": "string", "description": "At most 5 sentences." },
        "recall": {
          "type": "object",
          "required": ["kp_id", "prompt"],
          "additionalProperties": false,
          "properties": {
            "kp_id": { "type": "string" },
            "prompt": { "type": "string" }
          }
        }
      }
    }
  }
}
